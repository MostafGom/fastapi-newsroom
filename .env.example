# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development          # development | test | production
DEBUG=true

# Local Postgres runs on 5433.
DATABASE_URL=postgresql+asyncpg://newsroom:CHANGE_ME@localhost:5433/newsroom
TEST_DATABASE_URL=postgresql+asyncpg://newsroom:CHANGE_ME@localhost:5433/newsroom_test
# Traffic events and rollups. Not the editorial database.
ANALYTICS_DATABASE_URL=postgresql+asyncpg://newsroom:CHANGE_ME@localhost:5433/newsroom_analytics
TEST_ANALYTICS_DATABASE_URL=postgresql+asyncpg://newsroom:CHANGE_ME@localhost:5433/newsroom_analytics_test
# Used by containers. The host's localhost is not reachable from inside a container.
DOCKER_DATABASE_URL=postgresql+asyncpg://newsroom:CHANGE_ME@host.docker.internal:5433/newsroom
DOCKER_ANALYTICS_DATABASE_URL=postgresql+asyncpg://newsroom:CHANGE_ME@host.docker.internal:5433/newsroom_analytics
# Bundled Postgres only (`docker compose --profile db`). Password matches compose.
# DOCKER_DATABASE_URL=postgresql+asyncpg://newsroom:newsroom@db:5432/newsroom
# DOCKER_ANALYTICS_DATABASE_URL=postgresql+asyncpg://newsroom:newsroom@db:5432/newsroom_analytics

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

LOG_LEVEL=INFO
LOG_JSON=false                   # true in production

# Must be true behind HTTPS; false only for http://localhost
COOKIE_SECURE=false

DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=["ar","en"]

WORKER_POLL_SECONDS=30
MEDIA_DIR=data/media
PUBLIC_BASE_URL=http://localhost:8000
# Leave OPENROUTER_API_KEY empty to skip generated alt text and captions.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_TIMEOUT_SECONDS=20

# Leave SMTP_HOST empty to record briefings without sending them.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=desk@example.com
